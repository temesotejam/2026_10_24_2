  "plan": {
    "title": "所持品ゼロからドラゴン討伐：新しいサバイバルの字幕実況",
    "status": "reviewed edit from the completed new run; all clips in chronological order",
    "episodes": [
      {
        "title": "道具づくりと最初の戦闘",
        "clips": [
          {
            "part": "part-1.mp4",
            "start": 0,
            "end": 32,
            "speed": 1.25,
            "text": "所持品ゼロで出発。木を集めて、最初の道具を作ります。",
            "gamma": 1
          },
          {
            "part": "part-1.mp4",
            "start": 35,
            "end": 70,
            "speed": 3,
            "text": "石を掘って、石のツルハシとかまどを準備。（3倍速）",
            "gamma": 1
          },
          {
            "part": "part-1.mp4",
            "start": 74,
            "end": 98,
            "speed": 4,
            "text": "鉄の道具を目指して採掘。繰り返しの作業を短縮します。（4倍速）",
            "gamma": 1
          },
          {
            "part": "part-1.mp4",
            "start": 140,
            "end": 172,
            "speed": 1.5,
            "text": "鉄を精錬してツルハシを作り、自然のダイヤを探します。",
            "gamma": 1.2,
            "captions": [
              {
                "start": 18,
                "end": 21.2,
                "text": "ダイヤを入手。次の道具を準備します。"
              }
            ]
          },
          {
            "part": "part-2.mp4",
            "start": 6,
            "end": 46,
            "speed": 4,
            "text": "ネザーへ行くには黒曜石が必要。追加のダイヤと鉄を集めます。（4倍速）",
            "gamma": 1.2
          },
          {
            "part": "part-2.mp4",
            "start": 100,
            "end": 159,
            "speed": 3,
            "text": "ダイヤのツルハシ、鉄の剣、バケツを製作。遠征の装備がそろいました。（3倍速）",
            "gamma": 1.2
          },
          {
            "part": "part-2.mp4",
            "start": 238,
            "end": 262,
            "speed": 3,
            "text": "地上へ。食料を用意するため村に向かいます。（移動を一部省略）",
            "gamma": 1
          },
          {
            "part": "part-2.mp4",
            "start": 350,
            "end": 376,
            "speed": 1.5,
            "text": "村に到着。自然生成の宝箱を調べます。",
            "gamma": 1.3
          },
          {
            "part": "part-3.mp4",
            "start": 0,
            "end": 20,
            "speed": 1.5,
            "text": "畑の小麦を収穫し、パンを準備します。",
            "gamma": 1.4
          },
          {
            "part": "part-3.mp4",
            "start": 60,
            "end": 120,
            "speed": 6,
            "text": "収穫した場所には種を植え直します。準備中にも敵が来るので警戒。（6倍速）",
            "gamma": 1.4
          },
          {
            "part": "part-3.mp4",
            "start": 145,
            "end": 180,
            "speed": 1.4,
            "text": "収穫した小麦をパンに。体力回復と遠征のために持っていきます。",
            "gamma": 1.3
          },
          {
            "part": "part-4.mp4",
            "start": 123,
            "end": 174,
            "speed": 3,
            "text": "弓や矢、予備の道具に使う木材も補充。（移動と作業を短縮）",
            "gamma": 1.2
          },
          {
            "part": "part-4.mp4",
            "start": 185,
            "end": 218,
            "speed": 2,
            "text": "砂利から火打ち石を集めます。置き直して掘る作業も普通の操作です。（2倍速）",
            "gamma": 1
          },
          {
            "part": "part-4.mp4",
            "start": 383,
            "end": 401,
            "speed": 1.5,
            "text": "繰り返しを省略。実際に集めた火打ち石10個から着火具を作ります。",
            "gamma": 1
          },
          {
            "part": "part-4.mp4",
            "start": 426,
            "end": 444,
            "speed": 1.25,
            "text": "村の井戸で水を汲み、黒曜石の採掘に備えます。",
            "gamma": 1
          },
          {
            "part": "part-4.mp4",
            "start": 549,
            "end": 565,
            "speed": 1.5,
            "text": "食料と予備の剣も確保。遠征の準備ができました。",
            "gamma": 1
          },
          {
            "part": "part-5.mp4",
            "start": 0.5,
            "end": 11.4,
            "speed": 1,
            "text": "村のベッドで復活地点を設定。準備中の夜にはここで休みます。",
            "gamma": 1
          },
          {
            "part": "part-6.mp4",
            "start": 14,
            "end": 27,
            "speed": 1,
            "text": "パールを落とす敵との戦闘。倒しても、毎回ドロップするとは限りません。",
            "gamma": 1
          },
          {
            "part": "part-6.mp4",
